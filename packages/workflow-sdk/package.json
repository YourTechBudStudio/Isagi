{
  "name": "@yourtechbudstudio/isagi-workflow-sdk",
  "version": "0.1.0",
  "description": "Public authoring contract for Isagi workflows.",
  "license": "Apache-2.0",
  "author": "YourTechBud",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YourTechBudStudio/Isagi.git",
    "directory": "packages/workflow-sdk"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -b tsconfig.json --force",
    "check": "pnpm typecheck && pnpm test && pnpm pack --dry-run",
    "test": "pnpm build && node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json && tsc -p tsconfig.type-tests.json"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.14"
  },
  "engines": {
    "node": ">=22"
  }
}
