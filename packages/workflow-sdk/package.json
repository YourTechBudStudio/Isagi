{
  "name": "@yourtechbudstudio/isagi-workflow-sdk",
  "version": "0.0.1",
  "description": "Public authoring contract for Isagi workflows.",
  "license": "ISC",
  "author": "YourTechBud",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YourTechBudStudio/Isagi.git",
    "directory": "packages/workflow-sdk"
  },
  "files": [
