{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "plugins": ["eslint", "typescript", "oxc"],
  "jsPlugins": ["oxlint-tailwindcss"],
  "settings": {
    "tailwindcss": {
      "entryPoint": "apps/web/src/styles.css"
    }
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    "dist-electron",
    "out",
    "build",
    "release",
    ".turbo",
    ".opencode",
    "coverage",
    "apps/runtime/.generated"
  ],
  "rules": {
    "eslint/no-unused-vars": [
      "error",
      {
        "varsIgnorePattern": "^_",
        "argsIgnorePattern": "^_"
      }
    ],
    "eslint/no-underscore-dangle": ["error", { "allow": ["_tag"] }],
    "eslint/no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "zustand",
            "message": "Use effect/reactivity atoms (ADR 0001)."
          },
          {
            "name": "@tanstack/react-query",
            "message": "Use effect/reactivity atoms (ADR 0001)."
          },
          {
            "name": "@effect/atom-react",
            "importNames": ["RegistryProvider"],
            "message": "RegistryProvider creates a second registry; provide the app registry via RegistryContext."
          }
        ],
        "patterns": [
          {
            "group": [
              "effect/unstable",
              "effect/unstable/*",
              "@effect/schema",
              "@effect/schema/*",
              "@effect/platform",
              "@effect/platform/*"
            ],
            "message": "Effect v4 only: stable effect@4 ships no effect/unstable/*; Schema and platform modules live in effect itself (effect, effect/http, effect/process, ...)."
          }
        ]
      }
    ],
    "tailwindcss/enforce-canonical": "error"
  },
  "overrides": [
    {
      "files": ["apps/**/*", "packages/**/*"],
      "env": {
        "es2024": true
      }
    },
    {
      "files": ["apps/**/*.tsx", "packages/**/*.tsx"],
      "plugins": ["eslint", "typescript", "oxc", "react"],
      "env": {
        "browser": true,
        "es2024": true
      },
      "rules": {
        "react/only-export-components": "error",
        "react/react-in-jsx-scope": "off"
      }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/vitest.config.ts"
      ],
      "plugins": ["eslint", "typescript", "oxc", "react", "vitest"],
      "env": {
        "browser": true,
        "node": true,
        "vitest": true,
        "es2024": true
      },
      "rules": {
        "react/react-in-jsx-scope": "off"
      }
    }
  ]
}
