{
  "ignorePatterns": [
    "node_modules",
    "dist",
    "dist-electron",
    "out",
    "build",
    "release",
    ".turbo",
    ".opencode",
    "coverage",
    ".agents",
    ".pi",
    "apps/runtime/.generated",
    "apps/runtime/src/agent-sessions/harness/skill-content/*.md"
  ],
  "semi": true,
  "singleQuote": true,
  "sortImports": {
    "internalPattern": ["@isagi/"]
  },
  "sortPackageJson": {
    "sortScripts": true
  }
}
