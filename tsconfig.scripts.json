{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "apps/desktop/scripts/development-desktop-entry.mjs",
    "apps/desktop/scripts/development-desktop-entry.test.mjs",
    "apps/desktop/scripts/electron-runtime.mjs",
    "apps/desktop/scripts/electron-runtime.test.mjs",
    "apps/desktop/scripts/program-exit.mjs",
    "apps/desktop/scripts/program-exit.test.mjs",
    "apps/desktop/scripts/run-electron-builder.mjs",
    "apps/desktop/scripts/runtime-stage/errors.mjs",
    "apps/desktop/scripts/runtime-stage/process.mjs",
    "apps/desktop/scripts/runtime-stage/smoke.mjs",
    "apps/desktop/scripts/runtime-stage/stage.mjs",
    "apps/desktop/scripts/runtime-stage/stage.test.mjs",
    "apps/desktop/scripts/smoke-runtime-stage.mjs",
    "apps/desktop/scripts/stage-runtime.mjs",
    "apps/desktop/scripts/verify-linux-release.mjs",
    "apps/desktop/scripts/verify-macos-release.mjs",
    "apps/desktop/scripts/verify-macos-release.test.mjs",
    "scripts/dev-supervisor/controller.mjs",
    "scripts/dev-supervisor/signal-fixture.mjs",
    "scripts/dev-supervisor/supervisor.mjs",
    "scripts/dev-supervisor/supervisor.test.mjs",
    "scripts/sync-package-versions.mjs",
    "scripts/sync-package-versions.test.mjs",
    "scripts/verify-package-versions.mjs"
  ]
}
