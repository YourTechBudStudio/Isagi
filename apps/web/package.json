{
  "name": "@isagi/web",
  "version": "0.0.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "pnpm typecheck && pnpm build",
    "dev": "node scripts/vite-launcher.mjs dev",
    "preview": "pnpm build && node scripts/vite-launcher.mjs preview",
    "test": "tsx --expose-gc --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "test:browser": "node browser/check-chromium.mjs && pnpm build && playwright test -c browser/playwright.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@effect/atom-react": "catalog:",
    "@fontsource-variable/fira-code": "^5.2.7",
    "@fontsource-variable/sora": "^5.2.8",
    "@fontsource-variable/source-sans-3": "^5.2.9",
    "@isagi/contracts": "workspace:*",
    "@isagi/runtime-client": "workspace:*",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "@yourtechbudstudio/fluidcast-client": "0.0.1",
    "@yourtechbudstudio/fluidcast-core": "0.0.1",
    "@yourtechbudstudio/fluidcast-harness": "0.0.1",
    "@yourtechbudstudio/fluidcast-react": "0.0.1",
    "@yourtechbudstudio/fluidcast-tool-agent": "0.0.1",
    "@yourtechbudstudio/fluidcast-tool-ask": "0.0.1",
    "@yourtechbudstudio/fluidcast-tool-show": "0.0.1",
    "effect": "catalog:",
    "elkjs": "^0.12.0",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.14"
  }
}
