{
  "root": "apps/runtime/src",
  "compositionRoot": ["index.ts", "app/"],
  "testFiles": ["**/*.test.ts", "**/tests/**", "**/testing.ts", "**/*test-support.ts"],
  "modules": {
    "platform/fs": {
      "path": "platform/fs",
      "dependsOn": []
    },
    "platform/diagnostics": {
      "path": "platform/diagnostics",
      "dependsOn": []
    },
    "platform/assets": {
      "path": "platform/assets",
      "dependsOn": []
    },
    "platform/locks": {
      "path": "platform/locks",
      "dependsOn": []
    },
    "platform/events": {
      "path": "platform/events",
      "dependsOn": []
    },
    "platform/fibers": {
      "path": "platform/fibers",
      "dependsOn": ["platform/diagnostics"]
    },
    "platform/net": {
      "path": "platform/net",
      "dependsOn": ["platform/diagnostics"]
    },
    "platform/process": {
      "path": "platform/process",
      "dependsOn": ["platform/diagnostics", "platform/fs"]
    },
    "platform/persistence": {
      "path": "platform/persistence",
      "dependsOn": ["platform/fs", "platform/diagnostics"]
    },
    "platform/git": {
      "path": "platform/git",
      "dependsOn": ["platform/fs", "platform/diagnostics", "platform/process"]
    },
    "platform/http": {
      "path": "platform/http",
      "dependsOn": ["platform/diagnostics", "platform/persistence", "platform/git"]
    },
    "runtime-config": {
      "path": "runtime-config",
      "dependsOn": ["platform/*"]
    },
    "cli-access": {
      "path": "cli-access",
      "dependsOn": ["platform/*"]
    },
    "projects": {
      "path": "projects",
      "public": ["index.ts", "tables.ts"],
      "dependsOn": ["platform/*"]
    },
    "pty-processes": {
      "path": "pty-processes",
      "public": ["index.ts", "tables.ts"],
      "dependsOn": ["platform/*", "runtime-config", "cli-access"]
    },
    "commands": {
      "path": "commands",
      "public": ["index.ts", "tables.ts"],
      "dependsOn": ["platform/*", "projects", "pty-processes"]
    },
    "editor": {
      "path": "editor",
      "public": ["index.ts", "tables.ts"],
      "dependsOn": ["platform/*", "projects", "pty-processes"]
    },
    "harnesses": {
      "path": "harnesses",
      "dependsOn": ["platform/*", "runtime-config", "pty-processes", "editor"]
    },
    "environment": {
      "path": "environment",
      "public": ["index.ts", "tables.ts"],
      "dependsOn": ["platform/*", "projects", "pty-processes", "editor", "harnesses"]
    },
    "workspace": {
      "path": "workspace",
      "public": ["index.ts", "tables.ts"],
      "dependsOn": ["platform/*", "projects", "pty-processes", "commands", "environment"]
    },
    "workflows": {
      "path": "workflows",
      "public": ["index.ts", "tables.ts"],
      "dependsOn": [
        "platform/*",
        "projects",
        "runtime-config",
        "pty-processes",
        "harnesses",
        "environment",
        "workspace"
      ]
    },
    "runtime-events": {
      "path": "runtime-events",
      "dependsOn": ["platform/*", "environment", "workflows"]
    }
  },
  "tableOwners": {
    "projects": ["projects", "worktrees"],
    "pty-processes": ["ptyProcesses"],
    "commands": ["worktreeCommandStates", "worktreeCommandRuns"],
    "editor": ["editorContexts"],
    "environment": [
      "worktreeSurfaces",
      "surfacePanes",
      "worktreeEnvironmentStates",
      "agentSessions",
      "terminalSessions"
    ],
    "workspace": ["worktreeSetupTrust", "worktreeSetupRuns", "worktreeSetupSteps"],
    "workflows": [
      "workflowArtifacts",
      "workflowRuns",
      "workflowGraphInvocations",
      "workflowExecutions",
      "workflowOperations",
      "workflowEvents",
      "workflowCheckpoints"
    ]
  },
  "externals": {
    "node-pty": {
      "paths": ["pty-processes/adapters/"]
    },
    "better-sqlite3": {
      "paths": ["platform/persistence/", "harnesses/"]
    },
    "fastify": {
      "paths": ["platform/http/", "app/"],
      "basenames": ["api.ts", "*-api.ts", "*-route.ts"]
    },
    "@fastify/websocket": {
      "paths": ["platform/http/", "app/"]
    },
    "@fastify/cors": {
      "paths": ["app/"]
    },
    "node:child_process": {
      "paths": ["platform/process/"]
    },
    "child_process": {
      "paths": ["platform/process/"]
    }
  }
}
