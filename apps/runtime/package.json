{
  "name": "@isagi/runtime",
  "version": "0.0.7",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./launch": "./src/launch-contract.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "build": "pnpm prepare:source && vite build && node scripts/sync-runtime-assets.mjs --dist",
    "check": "pnpm build && pnpm typecheck:built && pnpm test:built",
    "db:generate": "cross-env NODE_OPTIONS=--conditions=import drizzle-kit generate",
    "prepare:source": "pnpm workspace-deps && node scripts/sync-runtime-assets.mjs",
    "test": "pnpm prepare:source && pnpm test:built",
    "test:built": "node scripts/test-shards.mjs",
    "typecheck": "pnpm workspace-deps && pnpm typecheck:built",
    "typecheck:built": "tsc --noEmit -p tsconfig.json",
    "workspace-deps": "pnpm -C ../../packages/workflow-sdk build && pnpm -C ../../packages/workflow-verifier build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.283",
    "@effect/ai-anthropic": "catalog:",
    "@effect/ai-openai": "catalog:",
    "@effect/ai-openai-compat": "catalog:",
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^10.1.8",
    "@fastify/websocket": "^11.2.0",
    "@isagi/shared": "workspace:*",
    "@yourtechbudstudio/fluidcast-core": "catalog:",
    "@yourtechbudstudio/fluidcast-harness": "catalog:",
    "@yourtechbudstudio/fluidcast-presets": "catalog:",
    "@yourtechbudstudio/fluidcast-tool-agent": "catalog:",
    "@yourtechbudstudio/fluidcast-tool-ask": "catalog:",
    "@yourtechbudstudio/fluidcast-tool-show": "catalog:",
    "@yourtechbudstudio/isagi-workflow-sdk": "workspace:*",
    "@yourtechbudstudio/isagi-workflow-verifier": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "effect": "catalog:",
    "fastify": "^5.12.7",
    "node-pty": "1.2.0-beta.15",
    "tinyglobby": "^0.2.17",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
