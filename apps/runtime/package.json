{
  "name": "@isagi/runtime",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "vite build",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "dev": "cross-env ISAGI_DATA_DIR=../../data/.isagi tsx src/index.ts",
    "dev:fixed": "cross-env ISAGI_DATA_DIR=../../data/.isagi PORT=17373 tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "node --import tsx --test --experimental-test-isolation=none --test-force-exit \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/websocket": "^11.2.0",
    "@isagi/contracts": "workspace:*",
    "better-sqlite3": "^12.10.0",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.21.2",
    "fastify": "^5.8.5",
    "node-pty": "^1.1.0",
    "tinyglobby": "^0.2.17",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "vite": "^8.0.14"
  }
}
