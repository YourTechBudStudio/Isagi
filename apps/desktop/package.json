{
  "name": "@isagi/desktop",
  "version": "0.0.1",
  "private": true,
  "description": "The Electron desktop shell for Isagi.",
  "author": "YourTechBud",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "build": "vite build",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "dev": "pnpm stage:runtime && pnpm build && electron .",
    "dev:install-launcher": "node scripts/development-desktop-entry.mjs install",
    "dev:prepared": "electron .",
    "dev:uninstall-launcher": "node scripts/development-desktop-entry.mjs uninstall",
    "dist:linux": "node scripts/run-electron-builder.mjs --linux AppImage --x64 --publish never",
    "dist:mac": "node scripts/run-electron-builder.mjs --mac dmg zip --publish never",
    "merge:mac-metadata": "node scripts/merge-macos-update-metadata.mjs",
    "pack:dir": "node scripts/run-electron-builder.mjs --dir --publish never",
    "smoke:runtime-stage": "node scripts/smoke-runtime-stage.mjs",
    "stage:runtime": "node scripts/stage-runtime.mjs",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"scripts/*.test.mjs\" \"scripts/runtime-stage/*.test.mjs\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:linux-release": "node scripts/verify-linux-release.mjs"
  },
  "dependencies": {
    "@isagi/contracts": "workspace:*",
    "effect": "^3.21.2",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^24.10.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.14"
  },
  "desktopName": "studio.yourtechbud.isagi.desktop"
}
