{
  "name": "isagi",
  "version": "0.0.5",
  "private": true,
  "description": "",
  "keywords": [],
  "license": "Apache-2.0",
  "author": "YourTechBud",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm format:check",
    "db:migrate": "pnpm -C apps/runtime exec cross-env NODE_OPTIONS=--conditions=import drizzle-kit generate",
    "dev": "pnpm dev:prepare && node scripts/dev-supervisor/index.mjs",
    "dev:install-launcher": "pnpm --filter @isagi/desktop dev:install-launcher",
    "dev:prepare": "pnpm build && pnpm --filter @isagi/desktop stage:runtime -- --skip-runtime-build",
    "dev:uninstall-launcher": "pnpm --filter @isagi/desktop dev:uninstall-launcher",
    "fix": "pnpm lint:fix && pnpm format",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --threads=8 --deny-warnings --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint . --threads=8 --fix --no-error-on-unmatched-pattern",
    "pack:desktop": "pnpm build && pnpm --filter @isagi/desktop pack:dir",
    "package:desktop:linux": "pnpm build && pnpm --filter @isagi/desktop dist:linux",
    "package:desktop:mac": "pnpm build && pnpm --filter @isagi/desktop dist:mac",
    "test": "pnpm test:scripts && pnpm test:versions-sync && pnpm test:release && pnpm -r --if-present test",
    "test:browser": "pnpm --filter @isagi/web test:browser",
    "test:release": "node --test \"scripts/release-pipeline/*.test.mjs\"",
    "test:scripts": "node --test \"scripts/dev-supervisor/*.test.mjs\"",
    "test:versions-sync": "node --test scripts/sync-package-versions.test.mjs && pnpm versions:verify",
    "typecheck": "pnpm -r --if-present typecheck",
    "versions:sync": "node scripts/sync-package-versions.mjs",
    "versions:verify": "node scripts/verify-package-versions.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "effect": "catalog:",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.67.0",
    "oxlint-tailwindcss": "^1.0.0"
  },
  "engines": {
    "node": "^24 || ^26"
  },
  "packageManager": "pnpm@12.15.0"
}
