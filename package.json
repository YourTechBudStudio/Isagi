{
  "name": "isagi",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "YourTechBud",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm format:check",
    "db:migrate": "pnpm -C apps/runtime exec drizzle-kit generate",
    "dev": "pnpm dev:prepare && node scripts/dev-supervisor/index.mjs",
    "dev:install-launcher": "pnpm --filter @isagi/desktop dev:install-launcher",
    "dev:prepare": "pnpm build && pnpm --filter @isagi/desktop stage:runtime -- --skip-runtime-build",
    "dev:uninstall-launcher": "pnpm --filter @isagi/desktop dev:uninstall-launcher",
    "fix": "pnpm lint:fix && pnpm format",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --threads=8 --deny-warnings --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint . --threads=8 --fix --no-error-on-unmatched-pattern",
    "pack:desktop": "pnpm build && pnpm --filter @isagi/desktop pack:dir",
    "package:desktop": "pnpm build && pnpm --filter @isagi/desktop dist",
    "test": "pnpm test:dev-supervisor && pnpm test:versions-sync && pnpm -r --if-present test",
    "test:browser": "pnpm --filter @isagi/web test:browser",
    "test:dev-supervisor": "node --test \"scripts/dev-supervisor/*.test.mjs\"",
    "test:versions-sync": "node --test scripts/sync-package-versions.test.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "versions:sync": "node scripts/sync-package-versions.mjs"
  },
  "devDependencies": {
    "effect": "^3.21.2",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "oxlint-tailwindcss": "^1.0.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
